# Loaded by Vite only when running `vite build` (mode=production), and it takes
# precedence over .env.
#
# WHY THIS FILE EXISTS
# client/vite.config.js sets envDir to the repository root so the Stripe
# publishable key is not duplicated. That means Vite also reads the root .env,
# which carries NODE_ENV=development for the API. Vite honours that value, so
# production builds were emitting React's development bundle: 455 kB instead of
# 200 kB, plus dev-only warnings and slower rendering.
#
# Pinning NODE_ENV here makes `npm run build` deterministic regardless of what
# .env says. Contains no secrets, so it is committed.
NODE_ENV=production
