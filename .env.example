NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/learnspace

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret

# ── Stripe ───────────────────────────────────────────────────────────────────
# Test keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY is server-only and must never be sent to the browser.
STRIPE_SECRET_KEY=sk_test_replace_me

# Safe to expose. Vite inlines any VITE_* var into the client bundle.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# From `stripe listen --forward-to localhost:4000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Prices are charged in this currency. Amounts are converted to the smallest
# unit (paise) before they reach Stripe.
CURRENCY=inr

# ── Email (optional) ─────────────────────────────────────────────────────────
# Used for account-deletion confirmation links. If unset, the link is printed
# to the server log instead of emailed, and nothing breaks.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LearnSpace <no-reply@learnspace.dev>

# ── Deployment ───────────────────────────────────────────────────────────────
# Where the browser app is served from. Used to build links inside emails.
PUBLIC_APP_URL=http://localhost:5173

# Render (API): comma-separated list of allowed browser origins.
#   CLIENT_ORIGIN=https://learn-space-coral.vercel.app
#
# Vercel (client): leave VITE_API_URL empty to use the /api rewrite in
# vercel.json. Set it only if you want the browser to call Render directly,
# which then requires the origin above to be allowed.
VITE_API_URL=
